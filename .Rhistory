# ----------
# 2. BASIC OPERATIONS
# ----------
# Calculator operations
5 + 3    # Addition
10 - 4   # Subtraction
3 * 8    # Multiplication
15 / 3   # Division
2^3      # Exponentiation
7 %% 2   # Modulus (remainder)
sqrt(25) # Square root
# ----------
# 3. VARIABLES & DATA TYPES
# ----------
# Assignment operators (<- or =)
x <- 10        # Numeric
y <- "Hello"   # Character (string)
z <- TRUE      # Logical (boolean)
x = 20        # Numeric
y = "Bye"   # Character (string)
z = FALSE      # Logical (boolean)
# Print variables
print(x)
cat("Message:", y, "\n")  # Better for combined output
# Check data types
class(x)       # "numeric"
rm(*)
rm(x,y,z)
# ----------
# 2. BASIC OPERATIONS
# ----------
# Calculator operations
5 + 3    # Addition
10 - 4   # Subtraction
3 * 8    # Multiplication
15 / 3   # Division
2^3      # Exponentiation
7 %% 2   # Modulus (remainder)
sqrt(25) # Square root
# ----------
# 3. VARIABLES & DATA TYPES
# ----------
# Assignment operators (<- or =)
x <- 10        # Numeric
y <- "Hello"   # Character (string)
z <- TRUE      # Logical (boolean)
x = 20        # Numeric
y = "Bye"   # Character (string)
z = FALSE      # Logical (boolean)
# Print variables
print(x)
cat("Message:", y, "\n")  # Better for combined output
# Check data types
class(x)       # "numeric"
typeof(y)      # "character"
is.logical(z)  # TRUE
# Type conversion
as.character(x)  # "10"
as.numeric("25") # 25
# ----------
# 4. DATA STRUCTURES
# ----------
# Vectors (homogeneous elements)
num_vec = c(1, 3, 5)          # Numeric vector
char_vec = c("a", "b", "c" ,"d")       # Character vector
log_vec = c(TRUE, FALSE, TRUE)    # Logical vector
1:10                               # Sequence vector
num_vec*c(1,0,1)
num_vec*log_vec
log_vec
log_vec*1
# Vector operations
num_vec * 2        # Scalar multiplication
num_vec + c(2, 4, 6)  # Element-wise addition
sum(num_vec)       # Summation
mean(num_vec)      # Average
length(char_vec)   # Number of elements
# Factors (categorical data)
grades = c("A", "B", "A", "C", "B")
factor_grades = factor(grades)
factor_grades
rm(list=ls())
for (x in 3:7){
cat(x,"^2=",x^2,"\n")
}
for (x in 3:7){
sprintf("%d^2=%d", x, x^2)
}
for (x in 3:7){
print(sprintf("%d^2=%d", x, x^2))
}
rm(x)
for (x in 3:7){
sprintf("%d^2=%d", x, x^2)
}
rm(x)
sprintf("When you square %f you get %f",x,x^2)
temperature = 35
if (temperature > 30) {
"Hot day!"
} else if (temperature > 20) {
"Pleasant weather"
} else {
"Cool day"
}
rm(list=ls())
# ----------
# 6. FUNCTIONS
# ----------
# Built-in functions
seq(1, 10, by = 2)  # Sequence generation
seq(10,104,5)
rep(c(1,2), times=3) # Replicate values
rep(0,10)
# ----------
# 7. BASIC PLOTTING
# ----------
# Scatter plot
x_vals = 1:10
y_vals = x_vals^2
plot(x_vals, y_vals,
main = "Quadratic Relationship",
xlab = "X Values",
ylab = "Y Values",
col = "blue",
pch = 19)
#=====================================
# Enhanced Quadratic Plot with Equation
x_vals <- seq(0, 10, length.out = 100)  # More points for smoother curve
y_vals <- x_vals^2
# Create the base plot
plot(x_vals, y_vals,
type = "n",  # Set up plot area without plotting points
main = "Quadratic Relationship: y = x²",
xlab = "X Values",
ylab = "Y Values",
xlim = c(0, 10),
ylim = c(0, 100),
las = 1)  # Makes y-axis labels horizontal
# Add grid lines
grid(col = "lightgray", lty = "dotted")
# Draw the quadratic curve
lines(x_vals, y_vals,
col = "red",
lwd = 2)
# Add points on top of the curve
k=10
points(x_vals[seq(1, 100, by = k)], y_vals[seq(1, 100, by = k)],  # Every 10th point
col = "blue",
pch = 19,
cex = 1.2)
# Add mathematical annotation for the equation
text(2, 80,
expression(y == x^2),
cex = 1.5,
col = "darkred")
# Add legend
legend("topleft",
legend = c("Quadratic Curve", "Sample Points"),
col = c("red", "blue"),
lty = c(1, NA),
pch = c(NA, 19),
lwd = c(2, NA),
bty = "n")
# Histogram
hist(rnorm(1000),     # Random normal distribution
breaks = 20,
col = "lightgreen",
main = "Normal Distribution")
# Bar plot
barplot(table(factor_grades),
col = c("green", "blue", "red"),
main = "Grade Distribution")
# Load package
library(tidyverse)
# Check installed packages
installed.packages()
